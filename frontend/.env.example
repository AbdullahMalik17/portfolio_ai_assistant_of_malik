# OpenRouter API Configuration (Powering Portfolio AI Assistant)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Resend API Configuration (Contact Form)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Email Configuration
# Gmail address where you want to receive contact form notifications
NOTIFICATION_EMAIL=muhammadabdullah51700@gmail.com

# Admin Inbox & Maintenance Endpoints
# Guards /api/admin/contacts, /api/test-db, /api/test-email, /api/init-db and
# /api/index-portfolio. Without it those endpoints return 503 and expose nothing.
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=your_long_random_token_here
